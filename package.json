{
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "aos": "^2.3.1",
    "esbuild": "^0.28.2"
  },
  "scripts": {
    "build:css": "npx @tailwindcss/cli -i ./src/input.css -o ./dist/output.css --minify",
    "build:js": "esbuild src/js/main.js --minify --target=es2018 --outfile=dist/main.js",
    "build": "npm run build:css && npm run build:js",
    "dev": "npx @tailwindcss/cli -i ./src/input.css -o ./dist/output.css --watch"
  }
}
